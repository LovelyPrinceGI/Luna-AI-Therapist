\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Overview of the full Luna AI Therapist pipeline: dual-LLM dialogue generation, Zonos TTS synthesis with director-assigned prosody, post-hoc text and speech VA extraction (vad-bert, WavLM), vocal descriptors (librosa), dissonance computation, and the four therapist generation conditions.}}{19}{figure.caption.13}\protected@file@percent }
\newlabel{fig:dataset-generation}{{3.1}{19}{Overview of the full Luna AI Therapist pipeline: dual-LLM dialogue generation, Zonos TTS synthesis with director-assigned prosody, post-hoc text and speech VA extraction (vad-bert, WavLM), vocal descriptors (librosa), dissonance computation, and the four therapist generation conditions}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Vocal prosodic descriptor extraction pipeline. Raw audio waveforms from Zonos synthesis are processed via \texttt  {librosa} to extract pitch (F0), loudness (RMS), and speaking rate, which are then converted into natural-language contextual descriptors for the Multimodal therapist condition.}}{20}{figure.caption.14}\protected@file@percent }
\newlabel{fig:preprocessing-pipeline}{{3.2}{20}{Vocal prosodic descriptor extraction pipeline. Raw audio waveforms from Zonos synthesis are processed via \texttt {librosa} to extract pitch (F0), loudness (RMS), and speaking rate, which are then converted into natural-language contextual descriptors for the Multimodal therapist condition}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Speech-channel VA estimates (WavLM on the synthesized client audio) for the 9,010 client turns of the two audio conditions (Multimodal and Dissonance-Aware) across all four backbones, plotted in Russell's circumplex. Point colour is the discrete sector label assigned to each turn; the clouds occupy exactly the angular regions of their own labels, confirming that emotion-directed TTS prosody is recovered by the speech emotion model in the intended circumplex region. The distribution is clinically plausible for a counseling population: mass concentrates in the distressed sectors (Sad, Angry, Tense, Depressed), while Happy, Calm and Content remain sparse, and the speech channel spans a wider arousal range than the text channel --- the variance that the dissonance computation exploits.}}{21}{figure.caption.15}\protected@file@percent }
\newlabel{fig:circumplex-speech}{{3.3}{21}{Speech-channel VA estimates (WavLM on the synthesized client audio) for the 9,010 client turns of the two audio conditions (Multimodal and Dissonance-Aware) across all four backbones, plotted in Russell's circumplex. Point colour is the discrete sector label assigned to each turn; the clouds occupy exactly the angular regions of their own labels, confirming that emotion-directed TTS prosody is recovered by the speech emotion model in the intended circumplex region. The distribution is clinically plausible for a counseling population: mass concentrates in the distressed sectors (Sad, Angry, Tense, Depressed), while Happy, Calm and Content remain sparse, and the speech channel spans a wider arousal range than the text channel --- the variance that the dissonance computation exploits}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Text-channel VA estimates (vad-bert) for the same 9,010 turns. Sector--label coincidence again holds, validating the mapping on the textual channel. The text side occupies a narrower region and never reaches the low-arousal sectors (Depressed, Calm and Content are absent), because vad-bert arousal for these client utterances rarely falls below zero; discrete text--speech mismatches therefore arise predominantly against low-arousal speech labels.}}{22}{figure.caption.16}\protected@file@percent }
\newlabel{fig:circumplex-text}{{3.4}{22}{Text-channel VA estimates (vad-bert) for the same 9,010 turns. Sector--label coincidence again holds, validating the mapping on the textual channel. The text side occupies a narrower region and never reaches the low-arousal sectors (Depressed, Calm and Content are absent), because vad-bert arousal for these client utterances rarely falls below zero; discrete text--speech mismatches therefore arise predominantly against low-arousal speech labels}{figure.caption.16}{}}
