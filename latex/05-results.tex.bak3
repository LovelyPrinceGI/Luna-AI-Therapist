\hline
\textbf{Backbone} & \textbf{Under.\ $\Delta$} & \textbf{CTRS-C $\Delta$} & \textbf{CTRS-G $\Delta$} & \textbf{CTRS-F $\Delta$} & \textbf{CTRS-S $\Delta$} & \textbf{Avg $\Delta$} & \textbf{Pairwise net} \\ \hline
GPT-4o mini            & +0.06 & +0.05 & +0.24 & +0.34 & +0.17 & \textbf{+0.14} & \textbf{0.680**} \\
DeepSeek V3.2          & 0.00  & 0.00  & +0.02 & +0.05 & +0.09 & +0.02 & \textbf{0.660**} \\
