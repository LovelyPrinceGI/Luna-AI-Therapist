   "source": [
    "# dialogue_6_dissonance.py\n",
    "\n",
    "- Client = LLM\n",
    "\n",
    "- Therapist = LLM dissonance-aware (เห็น text VA + speech VA + delta แบบออนไลน์)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f67f616b",
   "metadata": {},
   "source": [
    "## 1. OpenAI client"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "c370013b",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "import getpass\n",
    "from typing import Tuple\n",
    "from pathlib import Path\n",
    "from openai import OpenAI\n",
    "import torch\n",
    "import numpy as np\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification\n",
    "\n",
    "MODEL = \"gpt-4o-mini\"   # เปลี่ยนได้\n",
    "\n",
    "def setup_client() -> OpenAI:\n",
    "    # บังคับถาม key ทุกครั้ง\n",
    "    if \"OPENAI_API_KEY\" in os.environ:\n",
    "        del os.environ[\"OPENAI_API_KEY\"]\n",
    "    key = getpass.getpass(\"Enter your OpenAI API key: \")\n",
    "    os.environ[\"OPENAI_API_KEY\"] = key\n",
    "    return OpenAI()\n",
    "\n",
    "client = setup_client()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dfb8204b",
   "metadata": {},
   "source": [
    "## 2. Text VA: ใช้ vad-bert (เหมือน dialogue_5)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8623a504",
   "metadata": {},
   "source": [
    "### Check device (cuda is needed for speed improvement)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f3b31d1e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "device(type='cuda')"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "device"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a9161b9e",
   "metadata": {},
   "outputs": [],
   "source": [
    "VAD_MODEL_NAME = \"RobroKools/vad-bert\"\n",
    "tokenizer = AutoTokenizer.from_pretrained(VAD_MODEL_NAME)\n",
    "vad_model = AutoModelForSequenceClassification.from_pretrained(VAD_MODEL_NAME).to(device)\n",
    "vad_model.eval()\n",
    "\n",
    "V_MIN, V_MAX = 1.0, 5.0\n",
    "A_MIN, A_MAX = 1.0, 5.0\n",
    "\n",
    "def _to_minus1_1(x: float, xmin: float = 1.0, xmax: float = 5.0) -> float:\n",
    "    return float(2 * (x - xmin) / (xmax - xmin) - 1.0)\n",
    "\n",
    "def get_text_VA(text: str) -> Tuple[float, float]:\n",
    "    enc = tokenizer(\n",
    "        text,\n",
    "        padding=True,\n",
    "        truncation=True,\n",
    "        max_length=128,\n",
    "        return_tensors=\"pt\",\n",
    "    )\n",
    "    enc = {k: v.to(device) for k, v in enc.items()}\n",
    "\n",
    "    with torch.no_grad():\n",
    "        out = vad_model(**enc)\n",
    "\n",
    "    vad = out.logits.cpu().numpy()[0]  # [V, A, D]\n",
    "    v_raw, a_raw, d_raw = vad.tolist()\n",
    "\n",
    "    v_norm = _to_minus1_1(v_raw, V_MIN, V_MAX)\n",
    "    a_norm = _to_minus1_1(a_raw, A_MIN, A_MAX)\n",
    "    return v_norm, a_norm\n",
    "\n"
   ]
  },
